{
  "version": 1,
  "timezone": "Asia/Singapore",
  "timezoneOffset": "+08:00",
  "api": {
    "baseUrl": "https://api.dooremi.com.sg",
    "userAgent": "okhttp/4.9.2",
    "acceptLanguage": "en-SG,en-GB;q=0.9,en;q=0.8",
    "timeoutMilliseconds": 12000,
    "endpoints": {
      "login": "/user/login",
      "checkLogin": "/user/checkLogin",
      "availability": "/user/booking/facilitySlot",
      "preview": "/user/booking/orderPreview",
      "createBooking": "/user/booking/createOrderV2",
      "bookingHistory": "/user/booking/history",
      "bookingDetail": "/user/booking/detail",
      "cancelBooking": "/user/booking/cancel"
    }
  },
  "defaults": {
    "bookingLeadDays": 14,
    "releaseHour": 12,
    "releaseMinute": 0,
    "armingWindowSeconds": 240,
    "gracePeriodSeconds": 300,
    "cancellationLeadSeconds": 15,
    "fireDelayMilliseconds": 10,
    "maximumSessions": 6
  },
  "hostedStrategy": {
    "armingWindowSeconds": 240,
    "gracePeriodSeconds": 300,
    "preparationLeadSeconds": 60,
    "cancellationLeadSeconds": 15,
    "preCancellationProbeCount": 3,
    "preCancellationMinimumSuccesses": 2,
    "latencyProbeCount": 10,
    "latencyPercentile": 0.75,
    "minimumLatencySamples": 7,
    "fallbackRoundTripMilliseconds": 120,
    "maximumTransmissionLeadMilliseconds": 250,
    "maximumEarlySubmissionMilliseconds": 5,
    "rejectedSubmissionRetryDelaysMilliseconds": [0, 0, 25, 100, 400, 1000],
    "rejectedSubmissionRetryStaggerMilliseconds": 0,
    "ambiguousReconciliationDelaysMilliseconds": [0, 250, 750, 1500],
    "externalWakeWindowSgt": "11:30-12:05"
  },
  "statuses": [
    "pending",
    "running",
    "succeeded",
    "partial",
    "failed",
    "missed",
    "cancelled"
  ]
}
